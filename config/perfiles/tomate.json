{
  "tipo": "tomate",
  "version": "1.0",
  "nota": "El calibre de los tomates se obtuvo de https://www.librosymanualesdeagronomia.com/%E2%9C%93-manual-del-cultivo-de-tomate-libros-gratis-agronomia/",
  "atributos": {
    "calibre": true,
    "peso": true,
    "madurez": true,
    "manchas": true
  },
  "calibre": {
    "dimension": "ancho_bbox",
    "dimension_opciones": ["ancho_bbox", "lado_menor_rect"],
    "unidad": "mm",
    "rango_validado_mm": [47.0, 150.0],
    "altura_camara_mm": null,
    "categorias": [
      {"nombre": "Pequeño",      "min_mm": 47.0, "max_mm": 56.0},
      {"nombre": "Mediano",      "min_mm": 56.0, "max_mm": 66.0},
      {"nombre": "Grande",       "min_mm": 66.0, "max_mm": 81.0},
      {"nombre": "Extra grande", "min_mm": 81.0, "max_mm": 150.0}
    ]
  },
  "madurez": {
    "hsv": {
      "rojo":       {"h_bajo": [0, 10], "h_alto": [170, 179], "s_min": 90, "v_min": 50},
      "transicion": {"h": [11, 35], "s_min": 70, "v_min": 50},
      "verde":      {"h": [36, 85], "s_min": 50, "v_min": 40}
    },
        "excluir": {
      "sombra_v_max": 45,
      "reflejo_s_max": 60,
      "reflejo_v_min": 200,
      "dilatar_reflejo_px": 2
