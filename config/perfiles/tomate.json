    "min_pixeles_validos": 400,
    "min_fraccion_valida": 0.5,
    "min_fraccion_clasificada": 0.5,
    "reglas": {
      "maduro_r_min": 0.6,
      "transicion_c_min": 0.25,
      "transicion_r_min": 0.15
    }
  },
  "manchas": {
    "suavizado_px": 5,
    "erosion_borde_px": 4,
    "v_relativo_max": 0.55,
    "s_relativo_max": 0.45,
    "cierre_px": 3,
    "apertura_px": 2,
    "area_min_mancha_px": 25,
    "umbral_con_manchas": 0.02,
    "excluir": {
      "reflejo_s_max": 50,
      "reflejo_v_min": 240,
      "dilatar_reflejo_px": 3
    },
    "min_pixeles_evaluables": 400,
    "min_fraccion_evaluable": 0.5
  },
  "peso": {
    "modelo": "config/peso_modelo_tomate.json"
